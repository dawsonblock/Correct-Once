{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effect-fabric.invalid/schema/effect-transition-v1.schema.json",
  "type": "object",
  "required": [
    "schema",
    "version",
    "states",
    "commands",
    "invariants"
  ],
  "properties": {
    "schema": {
      "const": "effect-fabric/transition-spec/v1"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "states": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "terminal",
          "ambiguous"
        ],
        "properties": {
          "terminal": {
            "type": "boolean"
          },
          "ambiguous": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "commands": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "sources",
          "target",
          "requested_effects"
        ],
        "properties": {
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "target": {
            "type": "string"
          },
          "requested_effects": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "idempotent_sources": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
